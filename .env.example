# All optional. With nothing set, Stage C is skipped and queued rows get LLM_FALLBACK, storage falls
# back to local SQLite, and every publish channel reports `simulated` — the demo still works.

# ============================ 1. Storage ============================
# Unset -> SQLite at IK_DB_PATH (default .data/ik.db). Fine locally, WRONG on Vercel: the function
# filesystem is ephemeral, so every deploy/cold start loses the saved week and the calendar event ids.
# Set this to any Postgres (Neon / Supabase / RDS) before deploying.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# IK_DB_PATH=.data/ik.db

# ============================ 2. Google Calendar ============================
# TWO identities are supported, and the choice decides whether teachers can be invited at all.
#
#   A. Publish as a PERSON — set GOOGLE_OAUTH_JSON and events carry attendees, so a class lands on
#      the teacher's own calendar with nothing for them to click. This is the only option that works
#      on a plain gmail.com account. {client_id, client_secret, refresh_token}, raw or base64.
#      Mint it with an OAuth "Desktop app" client + a one-time consent. Events show the consenting
#      human as organiser, and replies go to them. Takes precedence when both are set.
# GOOGLE_OAUTH_JSON={"client_id":"...","client_secret":"...","refresh_token":"..."}
#      NOTE: while the OAuth app sits in "Testing", Google expires the refresh token after 7 days.
#      Publish the app (Google Auth Platform -> Audience -> Publish app) to make it durable.
#
#   B. Publish as a BOT — the service account below. Writes events fine, but Google answers
#      403 forbiddenForServiceAccounts on any attendee, so teachers are named in the description
#      instead. People reach the schedule by subscribing to the calendar.
# A service account (IAM & Admin -> Service Accounts -> Keys -> JSON) with the Calendar API enabled.
# Share the target calendar with the service account address, "Make changes to events".
# Raw JSON or base64 both work — base64 is easier to paste into `vercel env add`.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_ID=cohort@group.calendar.google.com
# Optional: Workspace domain-wide delegation. Without it a service account CANNOT invite attendees
# (Google answers 403 forbiddenForServiceAccounts), so teacher invites are dropped and only the
# event is written. With it, SMEs are invited and notified.
# GOOGLE_IMPERSONATE=ops@yourdomain.com
# Per-cohort calendars are optional: set `calendar_id` on a batch in data/batches.json and student
# publishes go there instead of GOOGLE_CALENDAR_ID.

# ============================ 3. E-mail (Resend) ============================
# RESEND_API_KEY=re_...
# MAIL_FROM=schedule@yourdomain.com      # must be a verified sender/domain in Resend

# ============================ 4. SMS (Twilio) ============================
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1...                      # a number you own in Twilio

# ============================ 5. Staging guard (read this before going live) ============================
# The seed roster carries `.example` addresses and placeholder numbers. Set these while testing and
# every message goes to one inbox you own instead of bouncing off the provider (one message, not one
# per fake recipient). Unset them only once data/smes.json holds the real roster.
# PUBLISH_REDIRECT_TO=you@yourdomain.com
# PUBLISH_REDIRECT_SMS_TO=+91...
# CHANNEL_TIMEOUT=20                     # seconds per outbound HTTP call
# Kill switch: forces every channel to simulate whatever the credentials say. The browser flow suite
# publishes a whole week and saves it, so run it isolated from production — it refuses to start
# otherwise:  DATABASE_URL= IK_DB_PATH=/tmp/ik-flow-test.db PUBLISH_DISABLED=1 npm run dev:api
# PUBLISH_DISABLED=1

# ============================ 6. LLM (Stage C adjudication) ============================

# Option A — Anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5

# Option B — any OpenAI-compatible provider (used automatically when ANTHROPIC_API_KEY is unset)
LLM_API_KEY=
# Groq (free tier) — default when LLM_BASE_URL is unset:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# xAI Grok (paid):        LLM_BASE_URL=https://api.x.ai/v1                                       LLM_MODEL=grok-4-fast
# Google Gemini (free):   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai    LLM_MODEL=gemini-3.5-flash-lite
#                         LLM_EXTRA_BODY={"reasoning_effort":"low"}   # 3x faster per call, same picks
#                         LLM_CHUNK=40   # free tier = 20 requests/day/model; each run = ceil(queue/LLM_CHUNK) requests (2 here)
#                         (quota is per model: switching LLM_MODEL, e.g. gemini-3.7-flash, gives a fresh daily bucket)
# OpenRouter (:free):     LLM_BASE_URL=https://openrouter.ai/api/v1                              LLM_MODEL=<model>:free
# Force a provider when both keys are set: LLM_PROVIDER=anthropic|openai

# Option C — automatic failover. When a primary call fails on daily quota / rate limit / timeout, that chunk
# is retried on the fallback (in LLM_FALLBACK_CHUNK sub-chunks) before the deterministic fallback.
#   C1 — second model on the SAME key/base URL (e.g. another Gemini daily bucket): just set the model
# LLM_FALLBACK_MODEL=gemini-3.7-flash
# LLM_FALLBACK_EXTRA_BODY={"reasoning_effort":"low"}
# LLM_FALLBACK_CHUNK=40
#   C2 — separate provider/key (e.g. Groq; free tier = 8k tokens/min, so rescue is partial)
# LLM_FALLBACK_API_KEY=gsk_...
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1     (default when a fallback key is set)
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b                    (default)
# LLM_FALLBACK_CHUNK=12
